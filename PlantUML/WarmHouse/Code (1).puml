@startuml
title WarmHouse Code Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Container_Boundary(SensorsControlService, "Sensors Control Service") {
class User {
  +String name
  +String email
  +List<Scenario> scenarios
  +List<Sensor> sensors
  +void registerSensor(Sensor)
  +void deleteSensor(Sensor)
  +void control(Sensor)
  +void execute(Scenario)
}

class Sensor {
  +String type
  +State state
  +void control()
}

class State {
  +DateTime moment
  +Enum state
}

class Scenario {
  +List<Sensor> Sensors
  +void execute()
}
}

User "1" -- "0..*" Scenario : has
User "1" -- "0..*" Sensor : has
Sensor "1" -- "1" State : has
Scenario "1" -- "0..*" Sensor : includes

@enduml